# ================= 后端镜像（多阶段构建） =================
# 构建上下文为仓库根目录: docker build -f docker/Dockerfile-server .
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY sudutech-server/pom.xml ./
COPY sudutech-server/sudutech-common ./sudutech-common
COPY sudutech-server/sudutech-system ./sudutech-system
COPY sudutech-server/sudutech-workflow ./sudutech-workflow
COPY sudutech-server/sudutech-screen ./sudutech-screen
COPY sudutech-server/sudutech-report ./sudutech-report
COPY sudutech-server/sudutech-gen ./sudutech-gen
COPY sudutech-server/sudutech-ai ./sudutech-ai
COPY sudutech-server/sudutech-admin ./sudutech-admin
RUN mvn -q install -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/sudutech-admin/target/sudutech-admin.jar ./sudutech-admin.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "-Xms256m", "-Xmx512m", "/app/sudutech-admin.jar"]
