import request from '@/utils/request'

// 查询${functionName}列表
export function list${table.className}(query) {
  return request({ url: '/api/v1/${moduleName}/${businessName}/list', method: 'get', params: query })
}

// 查询${functionName}详情
export function get${table.className}(${pk.javaField}) {
  return request({ url: '/api/v1/${moduleName}/${businessName}/' + ${pk.javaField}, method: 'get' })
}

// 新增${functionName}
export function add${table.className}(data) {
  return request({ url: '/api/v1/${moduleName}/${businessName}', method: 'post', data })
}

// 修改${functionName}
export function update${table.className}(data) {
  return request({ url: '/api/v1/${moduleName}/${businessName}', method: 'put', data })
}

// 删除${functionName}
export function del${table.className}(${pk.javaField}) {
  return request({ url: '/api/v1/${moduleName}/${businessName}/' + ${pk.javaField}, method: 'delete' })
}
